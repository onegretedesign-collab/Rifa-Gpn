import React, { useEffect, useState } from 'react';
import { collection, query, onSnapshot, addDoc, updateDoc, doc, serverTimestamp, orderBy } from 'firebase/firestore';
import { db } from '../services/firebaseConfig';
import { DollarSign, Ticket, Layers, Plus, X, ToggleLeft, ToggleRight, Loader2 } from 'lucide-react';

export default function AdminDashboard() {
  const [campaigns, setCampaigns] = useState([]);
  const [orders, setOrders] = useState([]);
  const [loading, setLoading] = useState(true);
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [title, setTitle] = useState('');
  const [price, setPrice] = useState('');
  const [totalTickets, setTotalTickets] = useState('1000');
  const [imageUrl, setImageUrl] = useState('');

  useEffect(() => {
    const unsubCamp = onSnapshot(query(collection(db, 'campaigns'), orderBy('createdAt', 'desc')), (s) => {
      setCampaigns(s.docs.map(d => ({ id: d.id, ...d.data() })));
    });
    const unsubOrders = onSnapshot(collection(db, 'orders'), (s) => {
      setOrders(s.docs.map(d => ({ id: d.id, ...d.data() })));
      setLoading(false);
    });
    return () => { unsubCamp(); unsubOrders(); };
  }, []);

  const paidOrders = orders.filter(o => o.status === 'paid');
  const totalRevenue = paidOrders.reduce((acc, curr) => acc + Number(curr.total_amount || 0), 0);
  const totalSold = paidOrders.reduce((acc, curr) => acc + (curr.selected_numbers?.length || 0), 0);

  const handleCreate = async (e) => {
    e.preventDefault();
    await addDoc(collection(db, 'campaigns'), {
      title,
      price_per_ticket: parseFloat(price.replace(',', '.')),
      total_tickets: parseInt(totalTickets, 10),
      imageUrl: imageUrl || '[https://images.unsplash.com/photo-1518609878373-06d740f60d8b?auto=format&fit=crop&w=600&q=80](https://images.unsplash.com/photo-1518609878373-06d740f60d8b?auto=format&fit=crop&w=600&q=80)',
      status: 'active',
      createdAt: serverTimestamp()
    });
    setIsModalOpen(false);
    setTitle(''); setPrice('');
  };

  const toggleStatus = async (id, currentStatus) => {
    await updateDoc(doc(db, 'campaigns', id), {
      status: currentStatus === 'active' ? 'paused' : 'active'
    });
  };

  if (loading) return <div className="min-h-screen flex items-center justify-center"><Loader2 className="w-8 h-8 animate-spin text-emerald-500"/></div>;

  return (
    <div className="max-w-5xl mx-auto p-4 sm:p-8 space-y-6">
      <div className="flex justify-between items-center pb-4 border-b border-neutral-800">
        <div>
          <h1 className="text-xl font-bold">Admin Rifas GPN</h1>
          <p className="text-xs text-neutral-400">Visão financeira e controle</p>
        </div>
        <button onClick={() => setIsModalOpen(true)} className="flex items-center gap-1.5 px-4 py-2 bg-emerald-500 text-neutral-950 font-bold rounded-xl text-xs">
          <Plus className="w-4 h-4"/> Nova Rifa
        </button>
      </div>

      <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div className="p-5 bg-neutral-900 border border-neutral-800 rounded-2xl">
          <span className="text-xs text-neutral-400">Faturamento Realizado</span>
          <p className="text-2xl font-bold font-mono text-emerald-400 mt-1">R\$ {totalRevenue.toFixed(2).replace('.', ',')}</p>
        </div>
        <div className="p-5 bg-neutral-900 border border-neutral-800 rounded-2xl">
          <span className="text-xs text-neutral-400">Cotas Pagas</span>
          <p className="text-2xl font-bold font-mono text-white mt-1">{totalSold}</p>
        </div>
        <div className="p-5 bg-neutral-900 border border-neutral-800 rounded-2xl">
          <span className="text-xs text-neutral-400">Total de Pedidos Aprovados</span>
          <p className="text-2xl font-bold font-mono text-white mt-1">{paidOrders.length}</p>
        </div>
      </div>

      <div className="bg-neutral-900 border border-neutral-800 rounded-2xl overflow-hidden">
        <div className="p-4 border-b border-neutral-800 text-xs font-bold uppercase tracking-wider text-neutral-400">
          Campanhas Cadastradas
        </div>
        <div className="divide-y divide-neutral-800">
          {campaigns.map(camp => (
            <div key={camp.id} className="p-4 flex items-center justify-between text-xs">
              <div>
                <p className="font-bold text-sm text-white">{camp.title}</p>
                <p className="text-neutral-500 font-mono">Cota: R\$ {Number(camp.price_per_ticket).toFixed(2)} | Total: {camp.total_tickets}</p>
              </div>
              <button onClick={() => toggleStatus(camp.id, camp.status)} className="p-2">
                {camp.status === 'active' ? <ToggleRight className="w-6 h-6 text-emerald-400"/> : <ToggleLeft className="w-6 h-6 text-neutral-500"/>}
              </button>
            </div>
          ))}
        </div>
      </div>

      {isModalOpen && (
        <div className="fixed inset-0 bg-black/80 flex items-center justify-center p-4 z-50">
          <div className="bg-neutral-900 border border-neutral-800 p-6 rounded-3xl w-full max-w-sm space-y-4">
            <div className="flex justify-between items-center">
              <h3 className="font-bold text-sm">Criar Nova Rifa</h3>
              <button onClick={() => setIsModalOpen(false)}><X className="w-5 h-5 text-neutral-500"/></button>
            </div>
            <form onSubmit={handleCreate} className="space-y-3">
              <input type="text" required placeholder="Título do Prêmio" value={title} onChange={e => setTitle(e.target.value)} className="w-full bg-neutral-950 border border-neutral-800 rounded-xl p-3 text-xs" />
              <input type="text" required placeholder="Valor por Cota (Ex: 0.50)" value={price} onChange={e => setPrice(e.target.value)} className="w-full bg-neutral-950 border border-neutral-800 rounded-xl p-3 text-xs font-mono" />
              <input type="url" placeholder="URL da Foto do Prêmio" value={imageUrl} onChange={e => setImageUrl(e.target.value)} className="w-full bg-neutral-950 border border-neutral-800 rounded-xl p-3 text-xs font-mono" />
              <button type="submit" className="w-full py-3 bg-emerald-500 text-neutral-950 font-bold rounded-xl text-xs">Salvar e Publicar</button>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}