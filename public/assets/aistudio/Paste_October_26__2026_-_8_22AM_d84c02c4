          <Search className="w-3.5 h-3.5"/>
          Meus Bilhetes
        </Link>
      </div>

      {campaign ? (
        <div className="space-y-5">
          {/* Hero do Prêmio */}
          <div className="bg-neutral-900 border border-neutral-800 rounded-3xl overflow-hidden shadow-xl">
            <img 
