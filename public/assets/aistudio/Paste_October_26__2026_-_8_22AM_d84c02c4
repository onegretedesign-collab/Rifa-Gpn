import { db } from '../services/firebaseConfig';
import { Ticket, Sparkles, Search, ShieldCheck, Loader2 } from 'lucide-react';

export default function Home() {
  const navigate = useNavigate();
  const [campaign, setCampaign] = useState(null);
  const [ticketsCount, setTicketsCount] = useState(10);
  const [buyerName, setBuyerName] = useState('');
  const [buyerPhone, setBuyerPhone] = useState('');
  const [loading, setLoading] = useState(true);
  const [submitting, setSubmitting] = useState(false);

  useEffect(() => {
    async function loadCampaign() {
      const q = query(collection(db, 'campaigns'), where('status', '==', 'active'));
      const snap = await getDocs(q);
      if (!snap.empty) {
        setCampaign({ id: snap.docs[0].id, ...snap.docs[0].data() });
      }
      setLoading(false);
    }
    loadCampaign();
  }, []);

  const handlePhoneChange = (e) => {
    let v = e.target.value.replace(/\D/g, '');
    if (v.length > 11) v = v.slice(0, 11);
    if (v.length > 6) v = `(${v.slice(0, 2)}) ${v.slice(2, 7)}-${v.slice(7)}`;
    else if (v.length > 2) v = `(${v.slice(0, 2)}) ${v.slice(2)}`;
    setBuyerPhone(v);
  };

  const handleCheckout = async (e) => {
    e.preventDefault();
    if (!campaign || ticketsCount <= 0) return;

    setSubmitting(true);
