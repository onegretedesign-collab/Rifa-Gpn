        pix_code: "00020126580014br.gov.bcb.pix0136123e4567-e89b-12d3-a456-426614174000520400005303986540510.005802BR5913RIFAS GPN6008GOIANIA62070503***6304ABCD"
      });

      navigate(`/pagamento/${orderRef.id}`);
    } catch (err) {
      console.error(err);
      alert('Erro ao gerar pedido.');
    } finally {
      setSubmitting(false);
    }
